{
  "name": "coderoom",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestrateur local de collaboration entre outils de développement IA.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "api:dev": "tsx watch src/server/main.ts",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "web:dev": "vite --host 0.0.0.0",
    "worker:dev": "tsx watch src/worker/main.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src package.json tsconfig.json vite.config.ts eslint.config.mjs .prettierrc.json docker-compose.yml README.md",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
